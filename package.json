{
  "name": "template-customer-success-agent",
  "version": "1.0.0",
  "description": "A provider-neutral customer-success agent that finds renewal risk, prepares follow-up, waits for CSM approval, and updates CRM.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@mastra/core": "1.59.0",
    "@mastra/libsql": "1.20.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "1.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "1.25.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "mastra": {
      "@mastra/deployer": "1.59.0"
    }
  }
}
