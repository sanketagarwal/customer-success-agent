{
  "name": "template-customer-success-agent",
  "version": "1.0.0",
  "description": "A scheduled customer-success agent that finds renewal risk, prepares follow-up, waits for CSM approval, and updates CRM.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "evals": "tsx scripts/evals.ts",
    "validate": "npm run typecheck && npm run evals && npm run build"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "mastra": "latest",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
