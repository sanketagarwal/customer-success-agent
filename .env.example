# Fixtures boot and run without credentials.
DATA_SOURCE=fixture
TENANT_ID=demo-tenant
FIXTURE_TENANT_ID=demo-tenant
FIXTURE_PATH=./data/fixtures/accounts.json
FIXTURE_NOW=2026-08-17T09:00:00.000Z
MASTRA_DB_URL=file:./mastra.db
CUSTOMER_SUCCESS_CRON=0 9 * * 1
CUSTOMER_SUCCESS_TIMEZONE=UTC
MAX_ACCOUNT_CONCURRENCY=4

# Set GENERATION_MODE=model to use the Mastra model-backed intelligence adapter.
GENERATION_MODE=deterministic
MODEL=openai/gpt-5-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
ENABLE_OBSERVATIONAL_MEMORY=false
ENABLE_SEMANTIC_RECALL=false
EMBEDDING_MODEL=openai/text-embedding-3-small

# HubSpot is read/write only when DATA_SOURCE=hubspot.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_RENEWAL_PROPERTY=renewal_date

# Optional remote libSQL/Turso storage.
TURSO_AUTH_TOKEN=
